{
  "name": "hair-and-air",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "clinic:create": "tsx scripts/create-clinic.ts",
    "auth:schema": "npx auth@latest generate --config scripts/auth-cli.config.ts --output src/db/auth-schema.ts -y",
    "db:migrate:local": "tsx scripts/migrate-local.ts",
    "patient:create": "tsx --conditions=react-server scripts/create-patient.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource-variable/assistant": "^5.3.0",
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/noto-serif-hebrew": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/ibm-plex-sans-hebrew": "^5.3.0",
    "@fontsource/secular-one": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
