# Neon Postgres — use the dev branch locally, never production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/hair_and_air?sslmode=require&channel_binding=require"

# Field encryption — generate with: npm run keys:generate
# Different keys per environment. Losing these keys makes encrypted patient data unreadable.
FIELD_ENCRYPTION_KEYS="1:BASE64_32_BYTES"
FIELD_ENCRYPTION_CURRENT_VERSION="1"
BLIND_INDEX_KEY="BASE64_32_BYTES"

# Staff authentication (Better Auth). Secret: 32+ random characters, different per environment.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="RANDOM_32_PLUS_CHARS"
BETTER_AUTH_URL="http://localhost:3000"

# Local development only: set to "false" to skip staff 2FA enrollment. Ignored in production.
# REQUIRE_STAFF_2FA="false"

# Patient login SMS: "console" prints codes to the server log (development default; refused in production).
# SMS_DRIVER="console"

# Client IP for rate limits. On Vercel it is read automatically. Behind another proxy that overwrites
# x-forwarded-for, set this to "1"; otherwise forwarding headers are ignored.
# TRUST_PROXY_HEADERS="1"
