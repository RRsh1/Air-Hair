# Neon Postgres — use the dev branch locally, never production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/hair_and_air?sslmode=require&channel_binding=require"

# Field encryption — generate with: npm run keys:generate
# Different keys per environment. Losing these keys makes encrypted patient data unreadable.
FIELD_ENCRYPTION_KEYS="1:BASE64_32_BYTES"
FIELD_ENCRYPTION_CURRENT_VERSION="1"
BLIND_INDEX_KEY="BASE64_32_BYTES"
